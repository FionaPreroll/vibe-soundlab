{
  "name": "vibe-soundlab-player",
  "version": "1.0.0",
  "private": true,
  "description": "Drum & bass tracks written in Strudel, from atmospheric rollers to bangers, with a browser player.",
  "type": "module",
  "scripts": {
    "start": "python3 -m http.server 8000",
    "test": "node --import ./test/support/register.js --test \"test/**/*.test.js\"",
    "coverage": "node --import ./test/support/register.js --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-lines=95 --test-coverage-branches=85 --test-coverage-functions=95 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=lcov.info \"test/**/*.test.js\"",
    "e2e": "node test/e2e/player.e2e.js",
    "tracks": "node scripts/index-tracks.js",
    "samples": "node scripts/snapshot-samples.js"
  },
  "devDependencies": {
    "@strudel/core": "1.2.6",
    "@strudel/mini": "1.2.6",
    "@strudel/tonal": "1.2.6",
    "@strudel/transpiler": "1.2.6",
    "@strudel/web": "1.2.6",
    "jsdom": "^25.0.1",
    "playwright": "1.63.0",
    "superdough": "1.2.6"
  },
  "packageManager": "pnpm@12.16.1"
}
